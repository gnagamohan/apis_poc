# Host port for nginx (the ONLY port published to localhost)
NGINX_PORT=80

# PostgreSQL superuser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Application database for the to-do service
TODO_DB_NAME=tododb
TODO_DB_USER=todo_app
TODO_DB_PASSWORD=todo_app_pw

# pgAdmin login
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Play application secret for todo-mcp (>= 32 chars)
PLAY_HTTP_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars

# Auth service database
AUTH_DB_NAME=authdb
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=change-me

# HS256 signing key for JWTs (>= 32 bytes)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# User created by auth-service on startup if missing
AUTH_SEED_USER_EMAIL=demo@example.com
AUTH_SEED_USER_PASSWORD=demo-password
